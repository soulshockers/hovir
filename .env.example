# Приклад конфігурації інстансу (SPEC.md 6.5).
# Локально: скопіюйте у `.env.local` і заповніть значеннями свого Supabase-проєкту.
# На Vercel обов'язкові змінні ставить інтеграція Supabase з Vercel Marketplace автоматично.

# --- Обов'язкові (ставить інтеграція Supabase) ---
# URL проєкту Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Публічний anon-ключ (доступний у браузері)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — лише на сервері, нікому не показуйте
SUPABASE_SERVICE_ROLE_KEY=
# Postgres через Supavisor у transaction mode (порт 6543) — для запитів застосунку
POSTGRES_URL=

# --- Опційні ---
# Postgres через Supavisor у session mode (порт 5432) — для міграцій; без неї використовується POSTGRES_URL
POSTGRES_URL_NON_POOLING=
# Пароль на створення презентацій і майстер-доступ /admin (за замовчуванням не задано — інстанс відкритий)
INSTANCE_PASSWORD=
# Мова за замовчуванням: uk | en (за замовчуванням uk)
DEFAULT_LOCALE=
# Через скільки днів видаляти завершені сесії (за замовчуванням 90)
RESULTS_RETENTION_DAYS=
